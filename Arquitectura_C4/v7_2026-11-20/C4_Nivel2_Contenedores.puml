@startuml C4_Nivel2_Contenedores
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Nivel 2: Contenedores — JackSoft

Person(cliente, "Cliente", "Usa la web o la app móvil.")
Person(admin, "Administrador", "Usa la web.")
Person(cocina, "Personal de Cocina", "Usa la web (también en el celular).")
Person(domi, "Domiciliario", "Usa la web en el celular; la app móvil queda pendiente.")

System_Boundary(c1, "JackSoft") {
    Container(web, "Aplicación Web", "React", "Una sola aplicación: muestra las pantallas de Cliente, Administrador o Cocina según el rol; el menú y los botones salen de los permisos del usuario. Todo lo de la app móvil también está en la web: GPS del domiciliario desde el navegador y notificaciones web push.")
    Container(movil, "Aplicación Móvil", "Flutter / Dart", "Pendiente. Funciones del Cliente y del Domiciliario, incluido el envío de GPS.")
    Container(api, "Backend API", "Node.js / NestJS / TypeScript", "Aplica las reglas de negocio y expone API REST y WebSocket.")
    ContainerDb(bd, "Base de Datos", "PostgreSQL", "Modelo bd.uml v4.8: 43 tablas de usuarios, roles y permisos, identidades de Google y Apple, códigos de acceso, dispositivos push, consentimientos, configuración, inventario, producción (con faltantes), ventas y logística.")
}

System_Ext(maps, "Google Maps Platform", "Mapas y geocodificación.")
System_Ext(cloudinary, "Cloudinary", "Comprobantes y fotos.")
System_Ext(fcm, "Firebase Cloud Messaging", "Push de la app móvil (pendiente).")
System_Ext(wp, "Servicios Web Push", "Push de los navegadores (VAPID).")
System_Ext(oidc, "Google y Apple", "OpenID Connect + PKCE (solo clientes).")
System_Ext(wa, "WhatsApp Business API", "Código de acceso.")

Rel(cliente, web, "Usa", "HTTPS")
Rel(cliente, movil, "Usa", "Android / iOS")
Rel(admin, web, "Usa", "HTTPS")
Rel(cocina, web, "Usa", "HTTPS")
Rel(domi, web, "Usa", "HTTPS (celular)")
Rel(domi, movil, "Usará", "Android / iOS")

Rel(web, api, "Consume la API", "HTTPS / JSON")
Rel(movil, api, "Consume la API", "HTTPS / JSON")
Rel(movil, api, "Envía GPS del domiciliario", "WebSocket")
Rel(web, api, "Envía GPS del domiciliario desde el navegador", "WebSocket")
Rel(api, web, "Publica ubicación en vivo", "WebSocket")
Rel(api, movil, "Publica ubicación en vivo", "WebSocket")

Rel(api, bd, "Lee y escribe", "SQL")
Rel(api, cloudinary, "Sube archivos y obtiene URL", "HTTPS")
Rel(api, fcm, "Solicita notificaciones", "HTTPS")
Rel(api, maps, "Geocodifica direcciones", "HTTPS")
Rel(api, oidc, "Valida el token del cliente", "HTTPS")
Rel(api, wa, "Envía el código de acceso", "HTTPS")
Rel(web, maps, "Carga el mapa", "HTTPS")
Rel(movil, maps, "Carga el mapa", "HTTPS")
Rel(fcm, movil, "Entrega notificaciones push")
Rel(api, wp, "Envía notificaciones web push", "HTTPS")
Rel(wp, web, "Entrega notificaciones al navegador")

@enduml
