@startuml C4_Nivel3_Suscripciones
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title Nivel 3: Detalle del módulo Clientes y suscripciones — JackSoft

Container(apps, "Aplicaciones Web y Móvil", "React / Flutter", "Consumen la API REST.")
ContainerDb(bd, "Base de Datos", "PostgreSQL", "clientes, direcciones_cliente, suscripciones, pagos.")
System_Ext(maps, "Google Maps Platform", "Geocodificación.")
System_Ext(cloudinary, "Cloudinary", "Comprobantes de pago.")
System_Ext(fcm, "Firebase Cloud Messaging", "Notificaciones push.")

Container_Boundary(mod, "Módulo Clientes y suscripciones (NestJS)") {
    Component(cc, "ClientesController", "Controlador", "Recibe las solicitudes de clientes y direcciones.")
    Component(sc, "SuscripcionesController", "Controlador", "Recibe cotizaciones, compras, renovaciones y suspensiones.")
    Component(pc, "PagosController", "Controlador", "Recibe comprobantes y su validación.")

    Component(cs, "ClientesService", "Servicio", "Registra clientes y valida la cobertura de la dirección.")
    Component(ss, "SuscripcionesService", "Servicio", "Controla el ciclo de vida: pendiente, activa, cancelada o vencida.")
    Component(ls, "LiquidacionService", "Servicio", "Calcula días facturables, descuento por festivos, recargo, cobro de cocas y total.")
    Component(ps, "PagosService", "Servicio", "Registra el comprobante y activa el plan cuando el administrador lo aprueba.")

    Component(cr, "ClientesRepository", "Repositorio", "Lee y escribe clientes y direcciones.")
    Component(sr, "SuscripcionesRepository", "Repositorio", "Lee y escribe suscripciones y suspensiones.")
    Component(pr, "PagosRepository", "Repositorio", "Lee y escribe pagos.")

    Component(mc, "MapasClient", "Cliente externo", "Conexión con Google Maps.")
    Component(ac, "ArchivosClient", "Cliente externo", "Conexión con Cloudinary.")
    Component(nc, "NotificacionesClient", "Cliente externo", "Conexión con Firebase.")
}

Component_Ext(cal, "Servicios y calendario", "Módulo NestJS", "Tarifas, días hábiles y festivos.")

Rel(apps, cc, "Gestiona clientes", "HTTPS")
Rel(apps, sc, "Gestiona suscripciones", "HTTPS")
Rel(apps, pc, "Envía y valida comprobantes", "HTTPS")

Rel(cc, cs, "Delega")
Rel(sc, ss, "Delega")
Rel(pc, ps, "Delega")

Rel(cs, cr, "Persiste")
Rel(cs, mc, "Geocodifica la dirección")
Rel(ss, sr, "Persiste")
Rel(ss, ls, "Solicita la liquidación")
Rel(ls, cal, "Consulta tarifa y festivos")
Rel(ps, pr, "Persiste")
Rel(ps, ac, "Guarda el comprobante")
Rel(ps, ss, "Activa la suscripción")
Rel(ps, nc, "Notifica el resultado")

Rel(cr, bd, "SQL")
Rel(sr, bd, "SQL")
Rel(pr, bd, "SQL")
Rel(mc, maps, "HTTPS")
Rel(ac, cloudinary, "HTTPS")
Rel(nc, fcm, "HTTPS")

@enduml
